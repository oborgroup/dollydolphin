.wrap { padding-bottom:24rpx; }
.oh { padding:24rpx 24rpx 6rpx; font-size:36rpx; font-weight:800; }
.oh .cnt { font-size:24rpx; color:var(--muted); font-weight:700; }

.cgroup { margin:20rpx 24rpx; background:#fff; border:1rpx solid var(--line); border-radius:24rpx;
  overflow:hidden; box-shadow:0 6rpx 20rpx rgba(14,46,78,.05); }
.gh { display:flex; align-items:center; padding:22rpx 24rpx; border-bottom:1rpx solid var(--line); }
.tcp { font-size:20rpx; font-weight:700; padding:5rpx 14rpx; border-radius:999rpx; color:#fff; }
.tcp.frozen { background:var(--frozen); } .tcp.ambient { background:var(--ambient); }
.gt { font-size:25rpx; font-weight:800; margin-left:14rpx; }
.gnote { margin-left:auto; font-size:19rpx; color:var(--muted); font-weight:700; }

.citem { display:flex; padding:24rpx; }
.thumb { width:120rpx; height:120rpx; border-radius:18rpx; flex:none; background:#fff; }
.thumb.ph { background:linear-gradient(150deg,var(--surface-2),#E7EEF6); }
.mid { flex:1; margin-left:20rpx; min-width:0; }
.mid .bk { font-size:17rpx; font-weight:700; letter-spacing:1rpx; color:var(--muted-2); }
.mid .nm { font-size:26rpx; font-weight:700; line-height:1.3; margin-top:2rpx;
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.mid .mt { display:block; font-size:20rpx; color:var(--muted); margin-top:6rpx; }
.mid .pr { display:block; color:var(--price); font-weight:800; font-size:30rpx; margin-top:10rpx; }
.stepper { display:flex; align-items:center; align-self:flex-end; }
.stepper .s { width:48rpx; height:48rpx; border:1rpx solid var(--line); border-radius:12rpx;
  text-align:center; line-height:44rpx; font-size:30rpx; color:var(--ink-2); }
.stepper .q { min-width:52rpx; text-align:center; font-size:26rpx; font-weight:700; }

.summary { margin:14rpx 24rpx 0; background:#fff; border:1rpx solid var(--line); border-radius:20rpx; padding:22rpx 26rpx; }
.summary .r { display:flex; justify-content:space-between; padding:8rpx 0; font-size:24rpx; color:var(--ink-2); }
.summary .save { color:#2E9E6B; font-weight:700; }
.summary .tot { border-top:1rpx solid var(--line); margin-top:10rpx; padding-top:16rpx;
  font-size:30rpx; font-weight:800; color:var(--ink); }

.checkoutbar { margin:22rpx 24rpx 0; background:#fff; border:1rpx solid var(--line); border-radius:20rpx;
  display:flex; align-items:center; padding:20rpx 24rpx; box-shadow:0 6rpx 20rpx rgba(14,46,78,.06); }
.checkoutbar .sel { flex:1; font-size:22rpx; color:var(--muted); font-weight:700; }
.checkoutbar .cbtn { flex:0 0 55%; text-align:center; background:var(--brand-deep); color:#fff;
  font-weight:800; font-size:28rpx; padding:24rpx 0; border-radius:18rpx; }

.empty { padding:160rpx 0; text-align:center; }
.empty .e1 { display:block; font-size:26rpx; color:var(--muted); }
.empty .ego { display:inline-block; margin-top:26rpx; background:var(--brand-deep); color:#fff;
  font-weight:800; font-size:24rpx; padding:18rpx 40rpx; border-radius:999rpx; }
