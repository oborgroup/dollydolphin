.wrap { padding-bottom:24rpx; }
.apphead { display:flex; align-items:center; padding:22rpx 24rpx 2rpx; }
.apphead .badge { width:58rpx; height:58rpx; border-radius:14rpx; background:#fff; box-shadow:0 4rpx 14rpx rgba(14,46,78,.08); }
.apphead .loc { margin-left:16rpx; }
.apphead .l1 { display:block; font-size:26rpx; font-weight:800; color:var(--ink); }
.apphead .l2 { display:block; font-size:19rpx; color:var(--muted); }
.searchbar { margin:16rpx 24rpx 20rpx; background:#fff; border:1rpx solid var(--line); border-radius:999rpx;
  padding:22rpx 30rpx; font-size:24rpx; color:var(--muted); box-shadow:0 6rpx 20rpx rgba(14,46,78,.05); }

.hero { margin:6rpx 24rpx 0; border-radius:28rpx; padding:38rpx 34rpx; color:#fff; overflow:hidden;
  background:linear-gradient(150deg,#0E2E4E,#123f63 60%,#1C74B8); }
.hero .kick { font-size:20rpx; letter-spacing:5rpx; opacity:.82; }
.hero .h { display:block; font-size:44rpx; font-weight:800; margin:16rpx 0 10rpx; letter-spacing:-.5rpx; }
.hero .sub { display:block; font-size:24rpx; opacity:.9; }
.cta { display:inline-block; margin-top:28rpx; background:#fff; color:#0E2E4E; font-weight:800;
  font-size:24rpx; padding:16rpx 32rpx; border-radius:999rpx; }

.qnav { display:flex; padding:28rpx 20rpx 2rpx; }
.q { flex:1; margin:0 6rpx; background:#fff; border:1rpx solid var(--line); border-radius:20rpx;
  padding:26rpx 0; text-align:center; box-shadow:0 6rpx 20rpx rgba(14,46,78,.05); }
.qk { font-size:25rpx; font-weight:700; color:var(--ink-2); }

.trust { display:flex; margin:22rpx 24rpx 0; background:#fff; border:1rpx solid var(--line);
  border-radius:18rpx; overflow:hidden; }
.trust .t { flex:1; text-align:center; font-size:20rpx; font-weight:700; color:var(--ink-2);
  padding:22rpx 0; border-right:1rpx solid var(--line); }
.trust .t:last-child { border-right:0; }

.foot-note { text-align:center; color:var(--muted-2); font-size:20rpx; padding:24rpx 0 6rpx; }
