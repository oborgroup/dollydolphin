.wrap { padding-bottom:24rpx; }
.lsthead { display:flex; align-items:center; justify-content:space-between; padding:24rpx 24rpx 6rpx; }
.lsthead .title { font-size:34rpx; font-weight:800; letter-spacing:-.5rpx; }
.lsthead .filter { font-size:24rpx; color:var(--muted); font-weight:700; }

.chiprow { white-space:nowrap; padding:14rpx 24rpx 4rpx; }
.chip { display:inline-block; font-size:23rpx; font-weight:700; padding:12rpx 26rpx; margin-right:14rpx;
  border-radius:999rpx; border:1rpx solid var(--line); background:#fff; color:var(--ink-2); }
.chip.on { background:var(--brand-deep); color:#fff; border-color:var(--brand-deep); }

.sortbar { display:flex; padding:18rpx 24rpx 14rpx; }
.sortbar text { font-size:24rpx; color:var(--muted); font-weight:700; margin-right:34rpx; }
.sortbar .on { color:var(--brand-ink); }

.empty { text-align:center; color:var(--muted); font-size:24rpx; padding:80rpx 0; }
