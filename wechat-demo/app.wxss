/* ===== Dolly Dolphin — global tokens & shared styles ===== */
page {
  --brand:#4AA6E0; --brand-deep:#1C74B8; --brand-strong:#0E2E4E; --brand-ink:#1B6FB0;
  --accent:#FF8FAE; --accent-soft:#FFE9F0; --accent-ink:#C43E63; --price:#E5486B;
  --frozen:#1E63A8; --chilled:#12938F; --ambient:#BE7C33;
  --bg:#F1F6FB; --surface:#FFFFFF; --surface-2:#F5F9FD; --line:#E2EAF2;
  --ink:#13232F; --ink-2:#2C3E4D; --muted:#6B7F92; --muted-2:#9DB0C0;
  background:var(--bg); color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue","Microsoft Yahei",sans-serif;
}
view, text, image { box-sizing:border-box; }

/* ---- product grid + card (shared by home & list) ---- */
.grid { display:flex; flex-wrap:wrap; justify-content:space-between; padding:0 24rpx; }
.card { width:340rpx; background:var(--surface); border:1rpx solid var(--line);
  border-radius:24rpx; overflow:hidden; margin-bottom:24rpx; box-shadow:0 6rpx 20rpx rgba(14,46,78,.05); }
.card-img { position:relative; width:100%; height:272rpx; background:#fff; padding:24rpx; box-sizing:border-box; }
.pimg { width:100%; height:100%; display:block; }
.flag { position:absolute; top:14rpx; left:14rpx; background:rgba(255,255,255,.92);
  border-radius:999rpx; font-size:19rpx; font-weight:700; padding:4rpx 14rpx; color:var(--ink); }
.tc { position:absolute; top:14rpx; right:14rpx; font-size:19rpx; font-weight:700;
  padding:4rpx 14rpx; border-radius:999rpx; color:#fff; }
.tc.frozen { background:var(--frozen); } .tc.chilled { background:var(--chilled); } .tc.ambient { background:var(--ambient); }
.card-b { padding:18rpx 20rpx 20rpx; }
.bk { display:block; font-size:17rpx; font-weight:700; letter-spacing:1rpx; color:var(--muted-2); margin-bottom:4rpx; }
.nm { font-size:25rpx; font-weight:700; line-height:1.3; color:var(--ink); min-height:64rpx;
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.meta { display:block; font-size:20rpx; color:var(--muted); margin:6rpx 0 14rpx; }
.foot { display:flex; align-items:center; }
.price { color:var(--price); font-weight:800; font-size:32rpx; }
.cur { font-size:22rpx; }
.mem { font-size:18rpx; font-weight:700; color:var(--accent-ink); background:var(--accent-soft);
  padding:3rpx 10rpx; border-radius:8rpx; margin-left:12rpx; }
.add { margin-left:auto; width:52rpx; height:52rpx; border-radius:16rpx; background:var(--brand-deep);
  color:#fff; font-size:34rpx; display:flex; align-items:center; justify-content:center; line-height:1; }

/* ---- shared section title ---- */
.sectitle { display:flex; align-items:baseline; justify-content:space-between; padding:34rpx 24rpx 18rpx; }
.st { font-size:32rpx; font-weight:800; letter-spacing:-.5rpx; }
.more { font-size:22rpx; color:var(--muted); }
